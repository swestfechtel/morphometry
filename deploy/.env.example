# Copy to deploy/.env and edit. Used both for compose interpolation (--env-file) and, via
# env_file, as the environment of the api and worker containers.

# Release to run. Upgrade or roll back by changing this and re-running `up -d`.
MORPH_VERSION=0.1.0

# Absolute host directory for the database, images and job scratch (_jobs/). Mounted at the same
# path inside the api and worker containers.
MORPH_DATA_DIR=/srv/morphometry

# gid of the host's docker group (the worker needs the docker socket):
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# Optional host ports.
# MORPH_API_PORT=8000
# MORPH_FRONTEND_PORT=3000

# Signing key for login tokens; generate with `openssl rand -hex 32`. Unset = generated and
# persisted under MORPH_DATA_DIR/.secret_key.
MORPH_API_SECRET_KEY=change-me
MORPH_API_AUTH_REQUIRED=true
# Comma-separated origins allowed to call the API from a browser (the frontend's public URL).
MORPH_API_CORS_ALLOW_ORIGINS=http://localhost:3000
