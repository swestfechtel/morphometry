# Copy to .env and adjust. All vars are prefixed MORPH_API_.

# Storage & persistence
MORPH_API_STORAGE_DIR=./api/data
# MORPH_API_DATABASE_URL=sqlite:////abs/path/api.db   # defaults to <storage_dir>/api.db
MORPH_API_LOG_DIR=./api/logs
MORPH_API_LOG_LEVEL=INFO
MORPH_API_ON_DUPLICATE=reject

# Task queue (Redis + RQ)
MORPH_API_REDIS_URL=redis://localhost:6379/0
MORPH_API_GPU_QUEUE_NAME=gpu
MORPH_API_JOB_TIMEOUT=3600
MORPH_API_ORTHANC_DEBOUNCE_SECONDS=10

# Docker model images
MORPH_API_NNUNET_IMAGE=swestfechtel/nnunet_torsion:latest
MORPH_API_TORSION_IMAGE=swestfechtel/torsion:latest
MORPH_API_DOCKER_SHM_SIZE=32G

# Auth & CORS
# User login (username/password) is managed with `python -m api.users`. Machine
# clients (e.g. the Orthanc plugin) authenticate with an API key instead.
# API keys (comma-separated) accepted alongside user tokens.
MORPH_API_API_KEYS=
# Require authentication (a user token OR an API key) on protected endpoints.
# Auth is also enforced automatically whenever API keys are set. Leave false for
# an open dev server.
MORPH_API_AUTH_REQUIRED=false
# Secret used to sign login tokens. If unset, a random key is generated and
# persisted to <storage_dir>/.secret_key. Set an explicit value in production
# (and share it across API replicas).
# MORPH_API_SECRET_KEY=change-me
# Login token lifetime in seconds (default 7 days).
MORPH_API_SESSION_TTL_SECONDS=604800
# Use '*' for quick local dev. For the Next.js UI in frontend/ (dev server on
# port 3000), set this to the UI origin, e.g.:
#   MORPH_API_CORS_ALLOW_ORIGINS=http://localhost:3000
MORPH_API_CORS_ALLOW_ORIGINS=*
